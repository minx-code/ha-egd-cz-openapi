{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:base",
    "homeassistant"
  ],
  "pip-tools": {
    "enabled": true
  },
  "regexManagers": [
    {
      "fileMatch": ["^custom_components/.+/manifest\\.json$"],
      "matchStrings": [
        "\"(?<depName>[^\"]+?)(?:[=><]+(?<currentValue>[^\"]+))?\""
      ],
      "datasourceTemplate": "pypi"
    }
  ]
}
